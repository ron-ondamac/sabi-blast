{
  "name": "blast-design-server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.18 <25"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "dotenv -e .env -- node-pg-migrate",
    "migrate:up": "dotenv -e .env -- node-pg-migrate up",
    "migrate:down": "dotenv -e .env -- node-pg-migrate down",
    "db:seed": "dotenv -e .env -- ts-node src/db/seeds/seed.ts",
    "db:create-admin": "dotenv -e .env -- ts-node src/db/seeds/createAdmin.ts",
    "db:create-admin:prod": "node dist/db/seeds/createAdmin.js",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "pg": "^8.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^7.4.2",
    "node-pg-migrate": "^7.6.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
